upstream lab6_web {
    zone lab6_web 64k;
    server {{ hostvars['web1'].private_ip }}:80 max_fails=1 fail_timeout=10s;
    server {{ hostvars['web2'].private_ip }}:80 max_fails=1 fail_timeout=10s;
}
server {
    listen 80 default_server;
    server_name _;
    location / {
        proxy_pass http://lab6_web;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        # Do not automatically replay a POST that may already have been processed.
    }
}
